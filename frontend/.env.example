# Copy to .env.local for local overrides. Every VITE_* value is embedded in the
# browser bundle at build time — never put secrets here. The LLM API key
# (ARCHLENS_LLM_API_KEY) belongs only in backend/.env.

# Base URL the browser uses for the API. The default "/api" is same-origin and
# is forwarded to FastAPI by the Vite dev proxy (dev) or nginx (Docker).
# Set a full URL only when the backend is on another origin, and add that
# frontend origin to the backend's ARCHLENS_CORS_ORIGINS.
# VITE_API_BASE_URL=/api

# Explicit demo mode: no backend calls, bundled sample data, labelled "demo".
# VITE_DEMO_MODE=false

# Dev-server only (not embedded): where the Vite proxy forwards /api.
# VITE_BACKEND_PROXY_TARGET=http://localhost:8000
