# ArchLens AI backend configuration.
# Copy to backend/.env (git-ignored). Every variable is optional; the values
# shown are the defaults. Docker Compose reads this file at runtime if present.
# Variables already set in the shell take precedence over this file.

# --- Storage --------------------------------------------------------------
# Where /v1/analyses stores one directory per analysis (artifacts + metadata).
# ARCHLENS_ANALYSES_DIR=output/analyses
# Artifact directory the /llm/* Copilot endpoints read (output of `archlens analyze`).
# ARCHLENS_ARTIFACTS_DIR=output

# --- Upload limits (/v1/analyses) -------------------------------------------
# ARCHLENS_MAX_UPLOAD_MB=50
# ARCHLENS_MAX_UNCOMPRESSED_MB=500
# ARCHLENS_MAX_ARCHIVE_FILES=20000
# ARCHLENS_MAX_CONCURRENT_ANALYSES=2
# Hard time limit per analysis in seconds; >0 runs the pipeline in a child
# process that is killed at the limit (code analysis_timeout). 0 = no limit.
# ARCHLENS_ANALYSIS_TIMEOUT_SECONDS=0

# --- Upload rate limits (in memory, sliding hour; 0 disables) -----------------
# ARCHLENS_UPLOAD_RATE_PER_HOUR=20
# ARCHLENS_UPLOAD_GLOBAL_PER_HOUR=120
# Number of proxies that APPEND to X-Forwarded-For in front of the app. 0 uses
# the peer address (right behind the bundled nginx, which overwrites the
# header). Render: 1.
# ARCHLENS_TRUSTED_PROXY_HOPS=0

# --- Retention ----------------------------------------------------------------
# Stored analyses (artifacts incl. short source excerpts) are deleted after this
# many hours; 0 keeps them forever. Uploaded archives are always deleted at once.
# ARCHLENS_RETENTION_HOURS=72
# Keep at most this many analyses; the oldest are evicted first. 0 = unlimited.
# Storage is plain files: on an ephemeral disk (Render free) every analysis is
# lost on restart, redeploy or spin-down.
# ARCHLENS_MAX_STORED_ANALYSES=0

# --- Scanner ----------------------------------------------------------------
# Skip source files larger than this (KB). Extra directory names to skip (comma-separated).
# ARCHLENS_MAX_FILE_SIZE_KB=1024
# ARCHLENS_EXCLUDE_PATTERNS=

# --- CORS -------------------------------------------------------------------
# Only needed when the UI is served from a different origin than the API
# (Render: two services). Both accept comma-separated http(s) origins and are
# merged; "*" is ignored. No credentials are allowed. Empty = CORS disabled.
# FRONTEND_ORIGIN=https://archlens-frontend.onrender.com
# ARCHLENS_CORS_ORIGINS=http://localhost:3000

# --- Legacy /llm/* endpoints ------------------------------------------------
# They read one server-wide ARCHLENS_ARTIFACTS_DIR and are not visitor-scoped.
# Set to false for any public deployment (the UI uses /v1 only).
# ARCHLENS_ENABLE_LEGACY_LLM_API=true

# --- Optional LLM Architecture Copilot (docs/LLM.md) ------------------------------
# Leave ARCHLENS_LLM_PROVIDER unset to run without an LLM (Copilot disabled).
# The key stays on the server: never commit it or put it in frontend/.env.
#
# NVIDIA Nemotron (OpenAI-compatible API):
# ARCHLENS_LLM_PROVIDER=nvidia
# ARCHLENS_LLM_API_KEY=<nvapi-… secret — never commit>
# ARCHLENS_LLM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# ARCHLENS_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# ARCHLENS_LLM_MAX_TOKENS=2048
# ARCHLENS_LLM_TIMEOUT=60
# ARCHLENS_LLM_MAX_RETRIES=2
# Only false/unset is supported for these two until verified for the model:
# ARCHLENS_LLM_THINKING=false
# ARCHLENS_LLM_STREAMING=false
#
# OpenAI-compatible provider:
# ARCHLENS_LLM_PROVIDER=openai
# ARCHLENS_LLM_MODEL=<model-name>
# ARCHLENS_LLM_API_KEY=<secret — never commit>
# ARCHLENS_LLM_BASE_URL=https://api.openai.com/v1
# ARCHLENS_LLM_TIMEOUT=30
#
# Offline development (canned answers, no network):
# ARCHLENS_LLM_PROVIDER=mock
# ARCHLENS_LLM_API_KEY=test-key
#
# Copilot usage limits (in-memory, per backend process):
# ARCHLENS_LLM_RATE_PER_MINUTE=6
# ARCHLENS_LLM_DAILY_QUOTA=200
# ARCHLENS_LLM_MAX_CONCURRENT=2
# ARCHLENS_COPILOT_MAX_QUESTION_CHARS=2000
