# ArchLens AI Backend Environment Configuration
# Copy this file to .env and fill in your values

# Required
ARCHLENS_ARTIFACTS_DIR=/app/output
ARCHLENS_LLM_PROVIDER=mock
ARCHLENS_LLM_API_KEY=test-key-for-development

# Optional (uncomment and configure for production)
# ARCHLENS_LLM_PROVIDER=openai
# ARCHLENS_LLM_MODEL=gpt-4
# ARCHLENS_LLM_API_KEY=your-openai-api-key-here
# ARCHLENS_LLM_BASE_URL=https://api.openai.com/v1
# ARCHLENS_LLM_TIMEOUT=30

# Application Settings
APP_HOST=0.0.0.0
APP_PORT=8000

# Security
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# CORS settings (if needed for web frontend)
CORS_ORIGINS=*

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Production settings
ENVIRONMENT=development
DEBUG=false

# Session settings
SESSION_TIMEOUT=3600
MAX_CONVERSATIONS=100

# Resource limits
MAX_FILE_SIZE_KB=1024
DEFAULT_EXCLUDE_PATTERNS=.git,__pycache__,venv,.env,node_modules,build,dist

# Monitoring and Health
HEALTH_CHECK_INTERVAL=30
HEALTH_TIMEOUT=10

# External services (if using Redis, PostgreSQL, etc.)
# REDIS_URL=redis://localhost:6379/0
# DATABASE_URL=postgresql://user:password@localhost/dbname

# LLM Provider Configuration
# For OpenAI provider only
OPENAI_API_KEY=your-openai-api-key-here
# For other providers, configure according to their documentation